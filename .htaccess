# =======================================================================
# SECURITY & REWRITE CONFIGURATION - E-PRESENSI PEGAWAI
# =======================================================================

RewriteEngine On

# 1. Paksa HTTPS jika belum HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. Matikan Directory Browsing / Indexing
Options -Indexes

# 3. Kunci Berkas-Berkas Sensitif
<FilesMatch "^(\.env|\.env\.example|\.git|error_log|composer\.(json|lock))|.*\.sql$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 4. Kunci Akses ke Folder Sesi jika dibuat ulang
RedirectMatch 403 ^/sessions/.*$

# 5. Header Keamanan Dasar
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>